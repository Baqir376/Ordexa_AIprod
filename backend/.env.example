# Copy to backend/.env for local runs. On a host, set these as environment variables instead.

# Database (local docker compose). Hosted URLs like postgres://user:pass@host/db?sslmode=require also work,
# and a plain DATABASE_URL is used when ORDEXA_DATABASE_URL is not set.
ORDEXA_DATABASE_URL=postgresql+psycopg://ordexa:ordexa@localhost:5432/ordexa

# production: requires a random ORDEXA_JWT_SECRET of 32+ characters
ORDEXA_ENVIRONMENT=development
ORDEXA_JWT_SECRET=

# Single-process hosting (free tiers): run the ai/channels/outbox workers inside the API.
ORDEXA_EMBEDDED_WORKERS=false
# Development shortcut: read AI orders inside the API request instead of the queue.
ORDEXA_AI_INLINE=false

# AI order reading: Claude when an Anthropic key is set (auto), else the built-in rule parser.
ORDEXA_AI_PROVIDER=auto
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (leave empty to use the simulator only)
ORDEXA_WHATSAPP_VERIFY_TOKEN=
ORDEXA_WHATSAPP_APP_SECRET=
ORDEXA_WHATSAPP_TOKEN=
ORDEXA_WHATSAPP_PHONE_NUMBER_ID=
